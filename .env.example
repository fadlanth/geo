# Contoh konfigurasi minimal. JANGAN commit nilai asli (lihat .gitignore -> .env*).
# Salin file ini menjadi `.env` lalu isi nilai asli.

# Supabase - project URL (ditemukan di Settings -> API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Kunci anon/publishable untuk aplikasi (Settings -> API -> API keys)
# PASTIKAN ini kunci "Publishable"/"anon", BUKAN "secret"/"service_role".
# Kunci service_role TIDAK BOLEH pernah masuk ke kode/depan publik.
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
